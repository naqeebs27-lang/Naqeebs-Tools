<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartTools.MainWindow"
        Title="Naqeebs Multi Services - Smart Tools"
        Icon="avares://SmartToolsSuite/Assets/icon.png"
        Width="1320" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="264,*">

    <!-- sidebar -->
    <Border Background="{DynamicResource BrandSidebar}">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="44">
          <TextBlock Classes="small" Foreground="#475569" VerticalAlignment="Center" Margin="21,0,0,0"
                     Text="Offline  &#x2022;  Windows &amp; Linux desktop edition" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,18,14,0">
            <Border Background="White" CornerRadius="14" Height="112">
              <Image Source="avares://SmartToolsSuite/Assets/logo.png" Stretch="Uniform" Margin="10,8" />
            </Border>
            <TextBlock Classes="small sidebartext" Margin="4,16,0,18"
                       Text="Smart Tools  &#x2022;  calculators &amp; codes" />
            <StackPanel x:Name="NavHost" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- content -->
    <Border Grid.Column="1" Background="{DynamicResource BrandBackground}">
      <ContentControl x:Name="ContentHost" />
    </Border>
  </Grid>
</Window>
