<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK TFM gives access to the built-in Windows.Data.Pdf renderer (used by "PDF to Image") -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <RootNamespace>SmartTools</RootNamespace>
    <AssemblyName>SmartToolsSuite</AssemblyName>
    <Product>Naqeebs Multi Services - Smart Tools</Product>
    <Company>Naqeebs Multi Services</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure managed barcode engine: PDF417 + QR encoders -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

</Project>
