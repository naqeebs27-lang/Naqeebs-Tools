<ui:ToolPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SmartTools.UI"
             x:Class="SmartTools.Tools.SalaryTaxTool"
             Title="Salaried Tax Calculator"
             Subtitle="Estimate income tax for a salaried person in Pakistan, tax years 2015 - 2027.">
  <Grid ColumnDefinitions="50*,50*">
    <Border Classes="card" Margin="0,0,10,0">
      <StackPanel>
        <TextBlock Classes="heading" Text="Salary details" />
        <TextBlock Classes="small muted" Text="Type the monthly amount and the annual figure fills in automatically" Margin="0,2,0,6" TextWrapping="Wrap" />
        <TextBlock Classes="caption" Text="Monthly salary (PKR)" Margin="0,8,0,6" />
        <ui:ModernTextBox x:Name="MonthlyBox" NumericOnly="True" Prefix="PKR" Placeholder="Enter monthly salary" />
        <TextBlock Classes="caption" Text="Annual salary (PKR)" Margin="0,14,0,6" />
        <ui:ModernTextBox x:Name="AnnualBox" NumericOnly="True" Prefix="PKR" Placeholder="Total annual salary" />
        <TextBlock Classes="caption" Text="Tax year" Margin="0,14,0,6" />
        <ui:ModernComboBox x:Name="YearBox" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,22,0,0">
          <Button x:Name="CalcButton" Classes="btn primary" Content="Calculate" />
          <Button x:Name="PrintButton" Classes="btn secondary" Content="Print / Preview" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Grid.Column="1" Margin="10,0,0,0">
      <StackPanel>
        <TextBlock Classes="heading" Text="Estimated tax" Margin="0,0,0,4" />
        <TextBlock x:Name="HintText" Classes="muted" Text="Enter a salary and press Calculate." Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="MonthlyCaption" Classes="caption" Text="Monthly tax" Margin="0,8,0,0" IsVisible="False" />
        <TextBlock x:Name="MonthlyTaxText" Classes="big accent" Margin="0,2,0,0" IsVisible="False" />
        <Border x:Name="ResultDivider" Classes="divider" Margin="0,14" IsVisible="False" />
        <TextBlock x:Name="AnnualCaption" Classes="caption" Text="Annual tax" IsVisible="False" />
        <TextBlock x:Name="AnnualTaxText" Classes="large" Margin="0,2,0,0" IsVisible="False" />
      </StackPanel>
    </Border>
  </Grid>
</ui:ToolPage>
